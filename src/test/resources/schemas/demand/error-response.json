{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Booking.com Demand API error response",
  "description": "See developers.booking.com > Demand API > Error handling",
  "type": "object",
  "required": ["errors"],
  "properties": {
    "request_id": { "type": "string" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "message"],
        "properties": {
          "id":      { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
