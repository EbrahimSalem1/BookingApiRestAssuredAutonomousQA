{
  "name": "autocomplete-cairo-arabic",
  "priority": 3,
  "request": {
    "method": "POST",
    "url": "/autocomplete.json",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.query",
          "contains": "القاهرة"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "bodyFileName": "autocomplete/cairo-ar.json"
  }
}