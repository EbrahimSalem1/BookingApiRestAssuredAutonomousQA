{
  "name": "demand-preview-unknown-product",
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/3.1/orders/preview",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.accommodation.products[0].id",
          "equalTo": "unknown-product"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "request_id": "01mockerr0000000000000000",
      "errors": [
        {
          "id": "invalid_product",
          "message": "Product 'unknown-product' is not available for this accommodation."
        }
      ]
    }
  }
}