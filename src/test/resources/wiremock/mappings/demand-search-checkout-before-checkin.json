{
  "name": "demand-search-checkout-before-checkin",
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/3.1/accommodations/search",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.checkout",
          "before": "now +45 days"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "request_id": "01mockerr0000000000000000",
      "errors": [
        {
          "id": "invalid_parameter",
          "message": "'checkout' must be after 'checkin'."
        }
      ]
    }
  }
}